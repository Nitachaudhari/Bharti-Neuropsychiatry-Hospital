# ==============================================================================
# BHARTI NEUROPSYCHIATRY HOSPITAL - BACKEND CONFIGURATION
# Copy this file to .env and provide your actual local/production credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development

# Frontend Client Origin (for CORS)
CORS_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://db_user:<password>@cluster0.bharti.mongodb.net/bharti_hospital_portal?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_high_entropy_random_32_char_secret_key
JWT_EXPIRES_IN=7d

# API Versioning Prefix
API_PREFIX=/api

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
